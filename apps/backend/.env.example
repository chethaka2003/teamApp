PROJECT_NAME="Team_APP Summit API"
API_V1_STR="/api/v1"

# PostgreSQL Local Connection
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_app_db

# Computed or override async database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/team_app_db

# JWT Security
SECRET_KEY=change-this-super-secret-jwt-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
